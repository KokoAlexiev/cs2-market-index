{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "bubble",
  "position": {
    "x": 16,
    "y": 16,
    "z": 0,
    "height": 340,
    "width": 620,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_item"
                    }
                  },
                  "Property": "category"
                }
              },
              "queryRef": "dim_item.category",
              "nativeQueryRef": "category",
              "active": true
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Sales Value"
                }
              },
              "queryRef": "fact_sales.Sales Value",
              "nativeQueryRef": "Sales Value"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Avg Sale Price"
                }
              },
              "queryRef": "fact_sales.Avg Sale Price",
              "nativeQueryRef": "Avg Sale Price",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Sales"
                }
              },
              "queryRef": "fact_sales.Sales",
              "nativeQueryRef": "Sales"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}