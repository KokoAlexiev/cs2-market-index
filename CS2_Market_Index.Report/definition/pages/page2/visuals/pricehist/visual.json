{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "pricehist",
  "position": {
    "x": 16,
    "y": 16,
    "z": 0,
    "width": 620,
    "height": 340,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "price_band"
                }
              },
              "queryRef": "fact_sales.price_band",
              "nativeQueryRef": "price_band",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Sales"
                }
              },
              "queryRef": "fact_sales.Sales",
              "nativeQueryRef": "Sales"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
