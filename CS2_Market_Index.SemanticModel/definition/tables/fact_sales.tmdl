	column price_band = SWITCH ( TRUE (), fact_sales[price] < 25, "< $25", fact_sales[price] < 50, "$25-50", fact_sales[price] < 100, "$50-100", fact_sales[price] < 250, "$100-250", fact_sales[price] < 500, "$250-500", fact_sales[price] < 1000, "$500-1k", fact_sales[price] < 2500, "$1k-2.5k", ">= $2.5k" )
		dataType: string
		lineageTag: b7f21f18-6226-4a48-b02a-992e0e26c726
		summarizeBy: none
		sortByColumn: price_band_ord

	column price_band_ord = SWITCH ( TRUE (), fact_sales[price] < 25, 0, fact_sales[price] < 50, 1, fact_sales[price] < 100, 2, fact_sales[price] < 250, 3, fact_sales[price] < 500, 4, fact_sales[price] < 1000, 5, fact_sales[price] < 2500, 6, 7 )
		dataType: int64
		isHidden
		lineageTag: 97d23a3b-32df-4ee0-bbc7-0672ac5cfbda
		summarizeBy: none

	column markup_band = SWITCH ( TRUE (), fact_sales[markup_pct] <= 0, "<= 0%", fact_sales[markup_pct] <= 2, "0-2%", fact_sales[markup_pct] <= 4, "2-4%", fact_sales[markup_pct] <= 6, "4-6%", fact_sales[markup_pct] <= 8, "6-8%", fact_sales[markup_pct] <= 10, "8-10%", fact_sales[markup_pct] <= 12, "10-12%", "> 12%" )
		dataType: string
		lineageTag: a048950b-e33f-4a5d-a9e1-095c7e04dcb3
		summarizeBy: none
		sortByColumn: markup_band_ord

	column markup_band_ord = SWITCH ( TRUE (), fact_sales[markup_pct] <= 0, 0, fact_sales[markup_pct] <= 2, 1, fact_sales[markup_pct] <= 4, 2, fact_sales[markup_pct] <= 6, 3, fact_sales[markup_pct] <= 8, 4, fact_sales[markup_pct] <= 10, 5, fact_sales[markup_pct] <= 12, 6, 7 )
		dataType: int64
		isHidden
		lineageTag: 5af63285-5c3b-4c8b-b40c-233fc83f650e
		summarizeBy: none

	column liq_band = SWITCH ( TRUE (), fact_sales[liquidity_pct] < 20, "0-20", fact_sales[liquidity_pct] < 40, "20-40", fact_sales[liquidity_pct] < 60, "40-60", fact_sales[liquidity_pct] < 80, "60-80", "80-100" )
		dataType: string
		lineageTag: 228d0354-21c7-4f33-a6b0-25f68fd21d56
		summarizeBy: none
		sortByColumn: liq_band_ord

	column liq_band_ord = SWITCH ( TRUE (), fact_sales[liquidity_pct] < 20, 0, fact_sales[liquidity_pct] < 40, 1, fact_sales[liquidity_pct] < 60, 2, fact_sales[liquidity_pct] < 80, 3, 4 )
		dataType: int64
		isHidden
		lineageTag: 5bdc948d-6321-4eb6-b9fe-c38ec540dc15
		summarizeBy: none

