table fact_sales
	lineageTag: 3a6fedd2-77cf-47d5-85ff-93cbdcc1d612

	measure Sales = COUNTROWS ( fact_sales )
		formatString: #,0
		lineageTag: a2cbf969-82a9-42e0-8df1-ed221302db48

	measure 'Sales Value' = SUM ( fact_sales[price] )
		formatString: \$#,0
		lineageTag: a1ec61cc-b471-46af-bbc4-d8215ef19cba

	measure 'Avg Sale Price' = AVERAGE ( fact_sales[price] )
		formatString: \$#,0.00
		lineageTag: 7ef864c7-e38a-48ee-9ef4-b4c955a12ae2

	measure 'Median Markup %' = MEDIAN ( fact_sales[markup_pct] )
		formatString: #,0.0
		lineageTag: 5ca8e50a-9061-45cc-8448-7111b4d32f14

	measure 'Market Index' = CALCULATE ( MEDIAN ( fact_sales[price_relative] ), fact_sales[in_index] = TRUE () ) * 100
		formatString: #,0.0
		lineageTag: 6c53ffd7-4427-4ba2-8dd1-065f7b636927

	measure 'Market Index 7d Avg' =
			AVERAGEX (
			    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -7, DAY ),
			    [Market Index]
			)
		formatString: #,0.0
		lineageTag: 9e6354f2-5c7c-45c1-bd28-21021997133a

	measure 'Index Change vs Base' = [Market Index] - 100
		formatString: +#,0.0;-#,0.0;0
		lineageTag: 37e14f28-ac09-41f5-816d-84ade6e901bc

	measure 'Index Change 7d Avg' = [Market Index 7d Avg] - 100
		formatString: +#,0.0;-#,0.0;0
		lineageTag: 7a4d3b82-a141-40cf-bf1f-9428a1cf44a4

	measure 'Rows With DQ Issue' = CALCULATE ( [Sales], fact_sales[dq_any_issue] = TRUE () )
		formatString: #,0
		lineageTag: 981d8ebf-8c51-496b-912a-6fa8ab12492c

	measure 'DQ Issue Rate %' = DIVIDE ( [Rows With DQ Issue], [Sales] ) * 100
		formatString: #,0.00
		lineageTag: b759c798-993b-4010-bf46-48acb97a8190

	measure 'Missing Buff Price' = CALCULATE ( [Sales], fact_sales[dq_missing_buff] = TRUE () )
		formatString: #,0
		lineageTag: ea6eaa3a-6010-450e-ad7f-f2f0aaa64678

	measure 'Extreme Markups' = CALCULATE ( [Sales], fact_sales[dq_extreme_markup] = TRUE () )
		formatString: #,0
		lineageTag: 693b5474-24de-41d1-bcc7-96e34ffce7e2

	measure 'Avg Liquidity' = AVERAGE ( fact_sales[liquidity_pct] )
		formatString: #,0.0
		lineageTag: d5e80c54-b520-4c88-8220-ce2e8895ee87

	measure 'Avg Buff %' = CALCULATE ( AVERAGE ( fact_sales[buff_pct] ), fact_sales[dq_extreme_buff_ratio] = FALSE () )
		formatString: #,0.0
		lineageTag: 24a0d8a6-9d5a-4713-bbca-172c9228628e

